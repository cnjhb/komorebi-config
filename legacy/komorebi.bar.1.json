{
  "$schema": "https://raw.githubusercontent.com/LGUG2Z/komorebi/v0.1.41/schema.bar.json",
  "monitor": {
    "index": 1,
    "work_area_offset": { "left": 0, "top": 50, "right": 0, "bottom": 50 }
  },
  "font_family": "JetBrainsMono NF",
  "theme": {
    "palette": "Base16",
    "name": "Dracula",
    "accent": "Base0D"
  },
  "left_widgets": [
    {
      "Komorebi": {
        "workspaces": {
          "enable": true,
          "hide_empty_workspaces": false
        },
        "focused_container": {
          "enable": true,
          "display": "IconAndText"
        }
      }
    }
  ],
  "right_widgets": [
    {
      "Komorebi": {
        "layout": {
          "enable": true,
          "display": "IconAndText"
        }
      }
    }
  ]
}
